# Node.js 22.13+ / node --env-file=.env server.mjs
PORT=3000
HOST=127.0.0.1
# Внешний адрес сайта с https, без завершающего слеша:
SITE_URL=
# Счётчик: только цифры, без префикса ym.
METRIKA_ID=
TELEGRAM_URL=
CONTACT_PHONE=
CONTACT_EMAIL=
# true публикует сайт и разрешает индексацию; false закрывает индексацию.
# Платёжный курс задан в коде отдельно; тарифы карго подтвердите до запуска.
PUBLIC_LAUNCH=false
# Не размещайте папку данных внутри public.
# DATA_DIR=/var/lib/klever

# Уведомления о заявках: заполнить на своём сервере.
# Не храните реальные значения в Git и не публикуйте .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Только socks5h: DNS для api.telegram.org разрешается через прокси.
# Спецсимволы логина/пароля нужно URL-кодировать.
TELEGRAM_PROXY_URL=
# Необязательно: PEM-файл доверенных CA для curl, если используется отдельное хранилище.
# CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
